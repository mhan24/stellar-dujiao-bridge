# Stellar Wholesale
STELLAR_BASE_URL=https://wholesale.stellarsecurity.com/api/v1
STELLAR_API_KEY=paste-stellar-api-key-here
STELLAR_WEBHOOK_SECRET=whsec_paste-secret-here

# Credentials that Dujiao will use when connecting to this bridge.
# Generate a random pair and enter the same values in Dujiao's upstream connection.
DUJIAO_API_KEY=bridge-esim-key
DUJIAO_API_SECRET=replace-with-a-long-random-secret

SITE_NAME=Stellar Wholesale eSIM
DB_PATH=/data/bridge.db
SYNC_INTERVAL_SECONDS=60
STELLAR_PAGINATION_DELAY_SECONDS=1.5
WALLET_CACHE_SECONDS=30
PRODUCT_WALLET_TIMEOUT_SECONDS=15
HTTP_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
# text (default) or json for log shippers
LOG_FORMAT=text

# Refuse catalogue snapshots that would remove more than half of the active plans.
CATALOGUE_MIN_ACTIVE_RATIO=0.5
CATALOGUE_MAX_PAGES=50
MAX_REQUEST_BODY_BYTES=1048576
# Downstream order numbers are the only durable idempotency source for new orders.
REQUIRE_DOWNSTREAM_ORDER_NO=1

# Durable queues: bounded retries, then dead-letter and prune finished rows.
CALLBACK_MAX_ATTEMPTS=20
WEBHOOK_MAX_ATTEMPTS=20
QUEUE_RETENTION_DAYS=30
# 0 keeps delivery payloads (QR/activation codes) forever; set e.g. 90 to purge
FULFILLMENT_RETENTION_DAYS=0
QUEUE_PRUNE_INTERVAL_SECONDS=3600

# esim.* webhooks for an unmapped eSIM refresh in-flight orders, capped and throttled.
ESIM_EVENT_SWEEP_LIMIT=20
ESIM_EVENT_SWEEP_COOLDOWN_SECONDS=5

# Select the ten affordable CN-only plans with exact China destination with the lowest price per GB.
TOP_PLAN_LIMIT=10
PLAN_UPGRADE_PRICE_TOLERANCE=0.01

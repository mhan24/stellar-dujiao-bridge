# Stellar Wholesale
STELLAR_BASE_URL=https://wholesale.stellarsecurity.com/api/v1
STELLAR_API_KEY=paste-stellar-api-key-here
STELLAR_WEBHOOK_SECRET=whsec_paste-secret-here

# Credentials that Dujiao will use when connecting to this bridge.
# Generate a random pair and enter the same values in Dujiao's upstream connection.
DUJIAO_API_KEY=bridge-esim-key
DUJIAO_API_SECRET=replace-with-a-long-random-secret

SITE_NAME=Stellar Wholesale eSIM
DB_PATH=/data/bridge.db
SYNC_INTERVAL_SECONDS=900
STELLAR_PAGINATION_DELAY_SECONDS=1.1
HTTP_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
